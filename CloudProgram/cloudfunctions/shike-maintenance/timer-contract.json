{
  "contractVersion": 1,
  "purpose": "AGC console timer mapping contract; not a provider trigger schema",
  "recommendedIntervalMinutes": 5,
  "handlerPayload": {
    "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION"
  },
  "alternateUserData": "JSON string containing workerToken",
  "environmentKey": "SHIKE_MAINTENANCE_TRIGGER_KEY",
  "minimumSecretLength": 32,
  "maximumJobsPerInvocation": 3,
  "rowsPerCleanupStep": 10,
  "lifecycleVerifiedDefault": false,
  "maintenanceEnabledDefault": false,
  "httpTrigger": false,
  "cardHistoryBackfill": {
    "handlerPayload": {
      "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION",
      "action": "card-history",
      "mode": "status"
    },
    "modes": ["status", "initialize", "run", "retry"],
    "defaultMode": "status",
    "writeRequiredFlag": "SHIKE_MAINTENANCE_ENABLED",
    "jobType": "BACKFILL_CARD",
    "jobIdentity": "BACKFILL_CARD:stage1-v1:1",
    "rowsPerInvocation": 20,
    "automaticTimerCreated": false,
    "lifecycleDeletionRequired": false
  },
  "reactionHistoryMigration": {
    "handlerPayload": {
      "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION",
      "action": "reaction-history",
      "mode": "status"
    },
    "modes": ["status", "run", "retry"],
    "defaultMode": "status",
    "writeRequiredFlag": "SHIKE_MAINTENANCE_ENABLED",
    "jobType": "MIGRATE_REACTION",
    "jobIdentity": "MIGRATE_REACTION:stage1-v1:1",
    "existingJobRequired": true,
    "rowsPerInvocation": 20,
    "automaticTimerCreated": false,
    "lifecycleDeletionRequired": false
  },
  "homeSnapshot": {
    "separateTimerRequired": true,
    "recommendedIntervalMinutes": 5,
    "handlerPayload": {
      "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION",
      "action": "home-snapshot"
    },
    "storageKey": "public/snapshot/home-v1.json",
    "requiredEnvironment": ["PROJECT_CREDENTIAL", "SHIKE_STORAGE_BUCKET"],
    "storageRule": "anonymous read of exactly public/snapshot/home-v1.json"
  },
  "mediaCoverBackfill": {
    "separateTimerRequired": true,
    "recommendedIntervalMinutes": 1,
    "handlerPayload": {
      "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION",
      "action": "media-covers"
    },
    "manualResumePayload": {
      "workerToken": "COPY_SECRET_FROM_DEPLOYED_TIMER_CONFIGURATION",
      "action": "media-covers",
      "retryFailed": true
    },
    "imagesPerInvocation": 1,
    "consecutiveFailuresBeforePause": 3,
    "requiredFlag": "SHIKE_MEDIA_COVERS_VERIFIED",
    "checkpointJobId": "media-cover-backfill-v1"
  }
}
