# DevEco Studio and Hvigor generated state
**/.idea/
!/Application/.idea/
/Application/.idea/*
!/Application/.idea/.gitignore
**/.hvigor/
**/.preview/
**/build/
**/oh_modules/
**/node_modules/
*.log
.DS_Store

# Local machine configuration and generated distribution artifacts
local.properties
*.hap
*.app
*.hsp
*.har

# Never version signing material, AGC project configuration with local secrets,
# or cloud-function environment files.
**/agconnect-services.json
**/clouddev/secrets.local.json
**/.env
**/.env.*
*.p12
*.p7b
*.cer
*.key
*.pem
*.jks
*.keystore

# Local cloud association and private workspace instructions
**/cloud-config.json
/AGENTS.md
/.github-publish/
**/__pycache__/

# Generated cloud entries and function-owned DevEco dependency copies
CloudProgram/cloudfunctions/shike-auth/shikeAuth.js*
CloudProgram/cloudfunctions/shike-service/shikeService.js*
CloudProgram/cloudfunctions/shike-media/shikeMedia.js*
CloudProgram/cloudfunctions/shike-location/shikeLocation.js*
CloudProgram/cloudfunctions/*/shared/
CloudProgram/cloudfunctions/shike-maintenance/service/
CloudProgram/cloudfunctions/shike-maintenance/media/
CloudProgram/cloudfunctions/shike-share/service/
